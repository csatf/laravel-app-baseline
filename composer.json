{
    "name": "csatf/laravel-app-baseline",
    "description": "Baseline runtime conventions for CSATF Laravel apps: security headers, app-version stamping, dashboard admin gates, a health endpoint, and an opt-in JSON exception envelope.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["csatf", "laravel", "baseline", "security-headers", "health", "versioning"],
    "authors": [
        {
            "name": "CSATF Engineering",
            "email": "engineering@csatf.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/process": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "csatf/laravel-devtools": "^1.1",
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "repositories": [
        { "type": "vcs", "url": "git@github.com:csatf/laravel-devtools.git" }
    ],
    "autoload": {
        "psr-4": {
            "Csatf\\LaravelBaseline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Csatf\\LaravelBaseline\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Csatf\\LaravelBaseline\\LaravelBaselineServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
